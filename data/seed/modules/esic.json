  "steps": [
    {
      "kind": "government",
      "id": "via-spice",
      "title": "ESIC registration through SPICe+",
      "description": "For a new company the ESIC registration number is issued through the SPICe+ form (AGILE-PRO-S); it is not issued separately and needs no separate filing.",
      "requirement": {
        "kind": "conditional",
        "condition": "New company incorporated through SPICe+",
        "rule": {
          "fact": "business.entity_type",
          "op": "in",
          "value": [
            "private_limited",
            "opc"
          ]
        }
      },
      "authoritySlug": "esic",
      "department": "Ministry of Corporate Affairs (SPICe+ / AGILE-PRO-S)",
      "mode": "online",
      "officeType": "online_portal",
      "applicationPortal": {
        "name": "MCA SPICe+",
        "url": "https://www.mca.gov.in/content/mca/global/en/mca/e-filing/incorporation-change-services/spice.html"
      },
      "forms": [
        {
          "name": "AGILE-PRO-S"
        }
      ],
      "documents": [],
      "outputs": [
        {
          "documentTypeId": "esic-registration-number",
          "name": "ESIC registration number (from SPICe+)"
        }
      ],
      "fee": {
        "kind": "unknown",
        "note": "No separate filing; the SPICe+ consolidated challan lists form, MoA, AoA, PAN, TAN and URC-1 fees only (MCA FAQ 32)."
      },
      "timeline": {
        "officialSla": {
          "kind": "unknown"
        },
        "conditional": []
      },
      "sourceIds": [
        "mca-faqs"
      ],
      "review": {
        "status": "verified",
        "verifiedOn": "2026-09-28",
        "note": "Checked 2026-09-28, MCA FAQs Q39: \"Registration for EPFO and ESIC shall be mandatory for all new companies incorporated w.e.f 23rd February 2020 through SPICe+ web form and EPFO &ESIC registration numbers shall not be separately issued\""
      }
    },
    {
      "kind": "government",
      "id": "register",
      "title": "Register the establishment with ESIC",
      "description": "Online registration of the establishment and its employees, through the Shram Suvidha Portal or the ESIC Employer Portal.",
      "requirement": {
        "kind": "conditional",
        "condition": "Not a company, and 10 or more employees",
        "rule": {
          "all": [
            {
              "not": {
                "fact": "business.entity_type",
                "op": "in",
                "value": [
                  "private_limited",
                  "opc"
                ]
              }
            },
            {
              "fact": "employees.count",
              "op": "gte",
              "value": 10,
              "sourceRef": "code-ss"
            }
          ]
        }
      },
      "authoritySlug": "esic",
      "department": "Employees' State Insurance Corporation",
      "mode": "online",
      "officeType": "online_portal",
      "applicationPortal": {
        "name": "ESIC Employer Portal",
        "url": "https://portal.esic.gov.in/ESICInsurance1/ESICInsurancePortal/ESICSignup.aspx"
      },
      "forms": [],
      "documents": [],
      "outputs": [
        {
          "documentTypeId": "esic-registration-number",
          "name": "ESIC employer code"
        }
      ],
      "fee": {
        "kind": "unknown",
        "note": "No registration fee stated in the reviewed sources."
      },
