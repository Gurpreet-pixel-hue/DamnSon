  "steps": [
    {
      "kind": "government",
      "id": "via-spice",
      "title": "EPFO registration through SPICe+",
      "description": "For a new company the EPFO registration number is issued through the SPICe+ form (AGILE-PRO-S); it is not issued separately and needs no separate filing.",
      "requirement": {
        "kind": "conditional",
        "condition": "New company incorporated through SPICe+",
        "rule": {
          "fact": "business.entity_type",
          "op": "in",
          "value": [
            "private_limited",
            "opc"
          ]
        }
      },
      "authoritySlug": "epfo",
      "department": "Ministry of Corporate Affairs (SPICe+ / AGILE-PRO-S)",
      "mode": "online",
      "officeType": "online_portal",
      "applicationPortal": {
        "name": "MCA SPICe+",
        "url": "https://www.mca.gov.in/content/mca/global/en/mca/e-filing/incorporation-change-services/spice.html"
      },
      "forms": [
        {
          "name": "AGILE-PRO-S"
        }
      ],
      "documents": [],
      "outputs": [
        {
          "documentTypeId": "epfo-registration-number",
          "name": "EPFO registration number (from SPICe+)"
        }
      ],
      "fee": {
        "kind": "unknown",
        "note": "No separate filing; the SPICe+ consolidated challan lists form, MoA, AoA, PAN, TAN and URC-1 fees only (MCA FAQ 32)."
      },
      "timeline": {
        "officialSla": {
          "kind": "unknown"
        },
        "conditional": []
      },
      "sourceIds": [
        "mca-faqs"
      ],
      "review": {
        "status": "verified",
        "verifiedOn": "2026-09-28",
        "note": "Checked 2026-09-28, MCA FAQs Q39: \"Registration for EPFO and ESIC shall be mandatory for all new companies incorporated w.e.f 23rd February 2020 through SPICe+ web form and EPFO &ESIC registration numbers shall not be separately issued\""
      }
    },
    {
      "kind": "government",
      "id": "register",
      "title": "Register the establishment with EPFO",
      "description": "Register the establishment as an employer with EPFO (employer services on epfo.gov.in, including the Shram Suvidha Portal).",
      "requirement": {
        "kind": "conditional",
        "condition": "Not a company, and 20 or more employees",
        "rule": {
          "all": [
            {
              "not": {
                "fact": "business.entity_type",
                "op": "in",
                "value": [
                  "private_limited",
                  "opc"
                ]
              }
            },
            {
              "fact": "employees.count",
              "op": "gte",
              "value": 20,
              "sourceRef": "code-ss"
            }
          ]
        }
      },
      "authoritySlug": "epfo",
      "department": "Employees' Provident Fund Organisation",
      "mode": "online",
      "officeType": "online_portal",
      "forms": [],
      "documents": [],
      "outputs": [
        {
          "documentTypeId": "epfo-registration-number",
          "name": "EPFO establishment code"
        }
      ],
      "fee": {
        "kind": "unknown",
        "note": "No registration fee stated in the reviewed sources."
      },
      "timeline": {
        "officialSla": {
          "kind": "unknown"
        },
        "conditional": []
      },
      "sourceIds": [
        "code-ss",
        "epfo-employer-docs",
        "epfo-faq"
      ],
      "review": {
        "status": "verified",
        "verifiedOn": "2026-09-28",
        "note": "Checked 2026-09-28, Code on Social Security, 2020, First Schedule: \"Every establishment in which twenty or more employees are employed.\""
      }
    },
    {
      "kind": "government",
      "id": "start-contributions",
      "title": "Start EPF contributions",
      "description": "EPF compliance starts once the establishment has 20 or more employees; until then no EPF compliance is required for a company registered through SPICe+.",
      "requirement": {
        "kind": "conditional",
        "condition": "20 or more employees",
        "rule": {
          "fact": "employees.count",
          "op": "gte",
          "value": 20,
          "sourceRef": "code-ss"
        }
      },
      "authoritySlug": "epfo",
      "department": "Employees' Provident Fund Organisation",
      "mode": "online",
      "officeType": "online_portal",
