    },
    {
      "fact": "intent.trademark",
      "text": "Do you want to register a trademark for your brand?"
    }
  ],
  "modules": [
    {
      "moduleId": "founder-kyc",
      "version": 1,
      "requirement": "mandatory",
      "activation": null,
      "reason": "Every director's identity is verified in SPICe+"
    },
    {
      "moduleId": "dsc",
      "version": 1,
      "requirement": "mandatory",
      "activation": null,
      "reason": "Each director signs the SPICe+ filing with a DSC"
    },
    {
      "moduleId": "mca-spice-plus",
      "version": 1,
      "requirement": "conditional",
      "activation": {
        "fact": "business.entity_type",
        "op": "in",
        "value": [
          "private_limited",
          "opc"
        ]
      },
      "reason": "Companies (Private Limited or One Person Company) incorporate through SPICe+"
    },
    {
      "moduleId": "bank-account",
      "version": 1,
      "requirement": "mandatory",
      "activation": null,
      "reason": "The company needs a bank account"
    },
    {
      "moduleId": "gst-registration",
      "version": 1,
      "requirement": "conditional",
      "activation": {
        "fact": "intent.gst_now",
        "op": "eq",
        "value": true
      },
      "reason": "Only if you register for GST now (can also be filed inside SPICe+ Part B)"
    },
    {
      "moduleId": "mh-shops-establishments",
      "version": 1,
      "requirement": "mandatory",
      "activation": null,
      "reason": "Establishments in Maharashtra: intimation or registration by worker count"
    },
    {
      "moduleId": "mh-professional-tax",
      "version": 1,
      "requirement": "conditional",
      "activation": {
        "not": {
          "fact": "business.entity_type",
          "op": "in",
          "value": [
            "private_limited",
            "opc"
          ]
        }
      },
      "reason": "Registered through SPICe+ for new companies in Maharashtra (MCA FAQ 38)"
    },
    {
      "moduleId": "epfo",
      "version": 1,
      "requirement": "conditional",
      "activation": {
        "all": [
          {
            "not": {
              "fact": "business.entity_type",
              "op": "in",
              "value": [
                "private_limited",
                "opc"
              ]
            }
          },
          {
            "fact": "employees.count",
            "op": "gte",
            "value": 20,
            "sourceRef": "code-ss"
          }
        ]
      },
      "reason": "Registered through SPICe+ for new companies (MCA FAQ 39); otherwise 20 or more employees"
    },
    {
      "moduleId": "esic",
      "version": 1,
      "requirement": "conditional",
      "activation": {
        "all": [
          {
            "not": {
              "fact": "business.entity_type",
              "op": "in",
              "value": [
                "private_limited",
                "opc"
              ]
            }
          },
          {
            "fact": "employees.count",
            "op": "gte",
            "value": 10,
            "sourceRef": "code-ss"
          }
        ]
      },
      "reason": "Registered through SPICe+ for new companies (MCA FAQ 39); otherwise 10 or more employees"
    },
    {
      "moduleId": "udyam",
      "version": 1,
      "requirement": "optional",
      "activation": {
        "fact": "intent.udyam",
        "op": "eq",
        "value": true
      },
      "reason": "MSME benefits"
    },
    {
      "moduleId": "dpiit-recognition",
      "version": 1,
      "requirement": "optional",
      "activation": {
        "fact": "intent.dpiit",
        "op": "eq",
        "value": true
      },
      "reason": "Startup India benefits"
    },
    {
      "moduleId": "ip-trademark",
      "version": 1,
      "requirement": "optional",
      "activation": {
        "fact": "intent.trademark",
        "op": "eq",
        "value": true
      },
      "reason": "Brand protection"
    },
    {
      "moduleId": "fssai",
      "version": 1,
      "requirement": "conditional",
      "activation": {
        "any": [
          {
            "fact": "business.sector",
            "op": "eq",
            "value": "food_service"
          },
          {
            "fact": "business.serves_food",
            "op": "eq",
            "value": true
          }
        ]
      },
      "reason": "Food businesses need FSSAI registration or a licence"
    }
  ],
