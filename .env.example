# Copy to .env.local and fill in. .env* is untracked; only this example is committed (§13.6).
# Real values live in Vercel settings, Google Secret Manager and local .env.local files.

# Public site URL (defaults to Vercel production URL or localhost:3000)
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Supavisor transaction pooler (port 6543): runtime queries through @prisma/adapter-pg
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# Supavisor session pooler (port 5432, IPv4): Prisma CLI only (migrate, seed).
# The direct db.<ref>.supabase.co host is IPv6-only and will not resolve for most of us.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# files (read data/seed), fixtures (dev only, synthetic), db
DATA_SOURCE=files

INTELLIGENCE_BASE_URL=http://localhost:8000
INTERNAL_SERVICE_SECRET=<long-random-string>
IP_HASH_SALT=<long-random-string>

# The civicweave-dev project ref. SEED_FIXTURES=1 npm run seed refuses to run unless DIRECT_URL
# contains this, so synthetic data can never reach the demo project.
DEV_PROJECT_REF=<dev-project-ref>

# Local only, for scripts/grant-admin.ts. Never add to Vercel.
SUPABASE_SECRET_KEY=sb_secret_<...>
