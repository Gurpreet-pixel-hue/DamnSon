{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gurpreet-pixel-hue/DamnSon/blob/main/docs/graph-data-schema.json",
  "title": "CivicTaskGraph",
  "description": "Contract for one civic procedure (e.g. 'register a cloud kitchen in Mumbai') as a dependency graph of steps. It stores reference data only. User progress/status, step order, parallel layers, 3D/2D positions, fee totals and total duration are DERIVED at runtime and must never be stored here. JSON Schema cannot express graph integrity, so lib/graph/analyzeGraph.ts additionally rejects duplicate ids, edges to unknown steps, self-loops, duplicate from->to pairs, cycles, ranges where min > max, and verified steps without an official source. Mirrored in code by lib/graph/schema.ts (zod); change both together.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "summary",
    "jurisdiction",
    "category",
    "keywords",
    "eligibility",
    "nodes",
    "edges",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Bump on any breaking change to this contract."
    },
    "taskId": { "$ref": "#/$defs/id" },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "Citizen-facing name, e.g. 'Register a cloud kitchen'."
    },
    "summary": { "type": "string", "maxLength": 600 },
    "jurisdiction": { "$ref": "#/$defs/jurisdiction" },
    "category": {
      "enum": [
        "business_and_trade",
        "food_and_hospitality",
        "property_and_tax",
        "building_and_construction",
        "utilities",
        "certificates_and_records",
        "transport_and_vehicles",
        "other"
      ]
    },
    "keywords": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 60 },
      "description": "Alternative phrasings for search and autocomplete, e.g. 'food delivery kitchen licence'."
    },
    "eligibility": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 },
      "description": "Who can apply / preconditions for the whole procedure."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/step" }
    },
    "edges": {
      "type": "array",
      "maxItems": 120,
      "items": { "$ref": "#/$defs/edge" }
    },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase kebab-case slug, e.g. 'fssai-registration'."
    },
    "isoDate": { "type": "string", "format": "date" },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "note": { "type": "string", "maxLength": 300 },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "state", "city"],
      "properties": {
        "country": { "const": "IN" },
        "state": { "type": "string", "minLength": 2, "maxLength": 60 },
        "city": { "type": "string", "minLength": 2, "maxLength": 60 },
        "localBody": {
          "type": "string",
          "maxLength": 120,
          "description": "e.g. 'Municipal Corporation of Greater Mumbai (MCGM/BMC)'."
        },
        "ward": { "type": "string", "maxLength": 60 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "department",
        "requirement",
        "mode",
        "officeType",
        "forms",
        "documents",
        "fee",
        "processingTime",
        "sources",
        "review"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 3, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 600 },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Issuing authority, e.g. 'Food Safety and Standards Authority of India (FSSAI)'."
        },
        "requirement": { "$ref": "#/$defs/requirement" },
        "mode": { "enum": ["online", "in_person", "hybrid"] },
        "officeType": {
          "enum": [
            "online_portal",
            "municipal_hq",
            "ward_office",
            "fire_services",
            "health_department",
            "revenue_office",
            "labour_department",
            "police",
            "pollution_control_board",
            "utility_provider",
            "court_or_notary",
            "other"
          ],
          "description": "Kind of place where the step happens; drives the 3D/2D visual archetype."
        },
        "office": { "$ref": "#/$defs/office" },
        "forms": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/form" }
        },
        "documents": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/document" }
        },
        "fee": { "$ref": "#/$defs/fee" },
        "processingTime": { "$ref": "#/$defs/duration" },
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/source" },
          "description": "Pages backing this step. A step whose review.status is 'verified' must have at least one official source (enforced by analyzeGraph)."
        },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "requirement": {
      "description": "Discriminated by `kind`. A conditional step applies only when `condition` holds; an optional step is recommended but not required.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "mandatory" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "condition"],
          "properties": {
            "kind": { "const": "conditional" },
            "condition": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "When the step applies, e.g. 'Kitchen area above the fire-safety threshold'."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "optional" },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "office": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "address": { "type": "string", "maxLength": 300 },
        "ward": { "type": "string", "maxLength": 60 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "hours": { "type": "string", "maxLength": 120 }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "code": {
          "type": "string",
          "maxLength": 40,
          "description": "Official form number, e.g. 'Form A'."
        },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "acceptedFormats": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 2, "maxLength": 40 },
          "description": "e.g. 'PDF', 'JPG', 'self-attested copy'."
        },
        "maxSizeKB": { "type": "integer", "minimum": 1, "maximum": 102400 },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "recurrence": { "enum": ["one_time", "annual"] },
    "fee": {
      "description": "Discriminated by `kind`. Totals are computed from fixed and range fees; variable/unknown fees are surfaced separately, never guessed.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "free" },
            "note": { "$ref": "#/$defs/note" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "amountINR", "recurrence"],
          "properties": {
            "kind": { "const": "fixed" },
            "amountINR": { "type": "number", "minimum": 0 },
            "recurrence": { "$ref": "#/$defs/recurrence" },
            "note": { "$ref": "#/$defs/note" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minINR", "maxINR", "recurrence"],
          "properties": {
            "kind": { "const": "range" },
            "minINR": { "type": "number", "minimum": 0 },
            "maxINR": { "type": "number", "minimum": 0 },
            "recurrence": { "$ref": "#/$defs/recurrence" },
            "note": { "$ref": "#/$defs/note" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "note"],
          "properties": {
            "kind": { "const": "variable" },
            "recurrence": { "$ref": "#/$defs/recurrence" },
            "note": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "What the fee depends on, e.g. 'Based on carpet area'."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "unknown" },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "duration": {
      "description": "Processing time for one step. Total time is computed from the dependency graph (parallel steps overlap).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minDays", "maxDays", "dayType"],
          "properties": {
            "kind": { "const": "estimate" },
            "minDays": { "type": "integer", "minimum": 0, "maximum": 365 },
            "maxDays": { "type": "integer", "minimum": 0, "maximum": 365 },
            "dayType": { "enum": ["working", "calendar"] },
            "note": { "$ref": "#/$defs/note" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "unknown" },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "kind", "retrievedOn"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "kind": {
          "enum": [
            "portal",
            "form",
            "guideline",
            "fee_schedule",
            "act_or_rule",
            "faq",
            "other"
          ]
        },
        "retrievedOn": { "$ref": "#/$defs/isoDate" }
      },
      "description": "Whether a URL counts as official is decided in code (lib/graph/officialSources.ts: *.gov.in, *.nic.in and vetted exceptions), never stored in data."
    },
    "review": {
      "description": "Admin verification state of one step, discriminated by `status`. A graph counts as verified only when every step is verified.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "unverified" },
            "note": { "type": "string", "maxLength": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "verifiedOn"],
          "properties": {
            "status": { "const": "verified" },
            "verifiedOn": { "$ref": "#/$defs/isoDate" },
            "note": { "type": "string", "maxLength": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "note"],
          "properties": {
            "status": { "const": "flagged" },
            "note": {
              "type": "string",
              "minLength": 3,
              "maxLength": 500,
              "description": "What is wrong or missing."
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": {
          "$ref": "#/$defs/id",
          "description": "Prerequisite step id; it must be completed before `to` can start."
        },
        "to": { "$ref": "#/$defs/id" },
        "note": {
          "type": "string",
          "maxLength": 200,
          "description": "Why the dependency exists, shown when a step is locked."
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "revision", "updatedAt"],
      "properties": {
        "origin": {
          "enum": ["curated", "extracted", "ai_generated"],
          "description": "curated = hand-entered by an admin; extracted = pipeline from official pages; ai_generated = produced on demand without curation."
        },
        "revision": { "type": "integer", "minimum": 1 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
