    "type": "boolean",
    "label": "Register for GST now"
  },
  "intent.udyam": {
    "type": "boolean",
    "label": "Wants Udyam (MSME) registration"
  },
  "intent.dpiit": {
    "type": "boolean",
    "label": "Wants DPIIT startup recognition"
  },
  "intent.trademark": {
    "type": "boolean",
    "label": "Wants to register a trademark"
  },
  "applicant.type": {
    "type": "enum",
    "label": "Applicant",
    "values": [
      "owner",
      "tenant",
      "legal_heir",
      "buyer",
      "company"
    ]
  }
