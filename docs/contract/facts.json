  "employees.count": {
    "type": "integer",
    "label": "Employees",
    "min": 0,
    "max": 100000
  },
  "premises.type": {
    "type": "enum",
    "label": "Premises",
    "values": [
      "rented",
      "owned",
      "home",
      "coworking"
    ]
  },
  "premises.built_up_area_sqm": {
    "type": "number",
