{
  "location.state": {
    "type": "string",
    "label": "State",
    "maxLength": 60
  },
  "location.city": {
    "type": "string",
    "label": "City",
    "maxLength": 60
  },
  "business.entity_type": {
    "type": "enum",
    "label": "Business entity",
    "values": [
      "private_limited",
      "llp",
      "opc",
      "partnership",
      "proprietorship"
    ]
  },
  "business.sector": {
    "type": "enum",
    "label": "Business sector",
    "values": [
      "it_saas",
      "food_service",
      "retail",
      "manufacturing",
      "services",
      "other"
    ]
  },
  "business.serves_food": {
    "type": "boolean",
    "label": "Makes, serves or sells food"
  },
  "business.imports_or_exports": {
    "type": "boolean",
    "label": "Imports or exports goods or services"
  },
  "company.founders_count": {
    "type": "integer",
    "label": "Founders / directors",
    "min": 1,
    "max": 10
