    "authority": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "tier": {
          "type": "string",
          "enum": [
            "central",
            "state",
            "municipal",
            "other"
          ]
        },
        "officialUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/"
        }
      },
      "required": [
        "slug",
        "name",
        "tier",
        "officialUrl"
      ],
      "additionalProperties": false
    },
    "eligibility": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "rule": {
            "$ref": "#/$defs/Rule"
          },
          "sourceRef": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "steps": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
