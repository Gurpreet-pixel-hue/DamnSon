      }
    },
    "edges": {
      "maxItems": 60,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "entrySteps": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
