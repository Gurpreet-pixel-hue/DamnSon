{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "taskId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "jurisdiction": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "const": "IN"
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "localBody": {
          "type": "string",
          "maxLength": 120
        },
        "ward": {
          "type": "string",
          "maxLength": 60
        }
      },
      "required": [
        "country",
        "state"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "enum": [
        "business_and_trade",
        "food_and_hospitality",
        "property_and_tax",
        "building_and_construction",
        "utilities",
        "certificates_and_records",
        "transport_and_vehicles",
        "other"
      ]
    },
    "keywords": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "sources": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "questions": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "modules": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "moduleId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "requirement": {
            "type": "string",
            "enum": [
              "mandatory",
              "conditional",
              "optional"
            ]
          },
          "activation": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rule"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "required": [
          "moduleId",
          "version",
          "requirement",
          "activation",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "fromModule": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "toModule": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "requires",
              "recommended_after"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 200
          },
          "via": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "id",
          "fromModule",
          "toModule",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "curated",
            "extracted",
            "ai_generated"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "origin",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "revision",
    "title",
    "summary",
    "jurisdiction",
    "category",
    "keywords",
    "sources",
    "questions",
    "modules",
    "links",
    "meta"
  ],
  "additionalProperties": false,
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": [
            "portal",
            "form",
            "guideline",
            "fee_schedule",
            "act_or_rule",
            "faq",
            "circular",
            "other"
          ]
        },
        "retrievedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "lastCheckedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "authoritySlug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "kind",
        "retrievedOn"
      ],
      "additionalProperties": false
    },
    "Question": {
      "type": "object",
      "properties": {
        "fact": {
          "type": "string",
          "enum": [
            "location.state",
            "location.city",
            "business.entity_type",
            "business.sector",
            "business.serves_food",
            "business.imports_or_exports",
            "company.founders_count",
            "employees.count",
            "premises.type",
            "premises.built_up_area_sqm",
            "intent.gst_now",
            "intent.udyam",
            "intent.dpiit",
            "intent.trademark",
            "applicant.type"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "help": {
          "type": "string",
          "maxLength": 300
        },
        "options": {
          "minItems": 2,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 120
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "fact",
        "text"
      ],
      "additionalProperties": false
    },
    "Rule": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "$ref": "#/$defs/Rule"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "$ref": "#/$defs/Rule"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Rule"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "enum": [
                "location.state",
                "location.city",
                "business.entity_type",
                "business.sector",
                "business.serves_food",
                "business.imports_or_exports",
                "company.founders_count",
                "employees.count",
                "premises.type",
                "premises.built_up_area_sqm",
                "intent.gst_now",
                "intent.udyam",
                "intent.dpiit",
                "intent.trademark",
                "applicant.type"
              ]
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "exists"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 120
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 120
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            },
            "valueText": {
              "type": "string",
              "maxLength": 200
            },
            "sourceRef": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "fact",
            "op"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "title": "JourneyTemplate (contract v3)"
}
